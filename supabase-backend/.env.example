# Copy this file to .env and fill in your real values.
# Find these in your Supabase project: Project Settings → API.

# Project URL, e.g. https://abcdefghijk.supabase.co
SUPABASE_URL=

# The "service_role" key (NOT the anon/public key). Keep this secret —
# it bypasses Row Level Security. Never put it in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Port the server listens on (optional, defaults to 3000)
PORT=3000

PAYSTACK_SECRET_KEY=sk_test_your_actual_key_here
CRON_SECRET=the_random_string_you_generated